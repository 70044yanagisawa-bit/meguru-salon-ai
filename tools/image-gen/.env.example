# このファイルを .env という名前でコピーして、キーを入れてください。
#   cp tools/image-gen/.env.example tools/image-gen/.env
# .env は .gitignore 済みなので GitHub には上がりません。

# OpenAI（https://platform.openai.com/api-keys で発行）
OPENAI_API_KEY=

# Google Gemini（https://aistudio.google.com/apikey で発行）
GEMINI_API_KEY=

# 使う順番。1つ目が失敗したら2つ目で作り直す。
IMAGE_PROVIDERS=openai,gemini

# モデルを変えたいときだけ書き換える（空なら既定値）
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_QUALITY=high
# GEMINI_IMAGE_MODEL=imagen-4.0-generate-001
